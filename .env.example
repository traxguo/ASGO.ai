# Copy this file to .env and fill in the values. .env is never committed.
# Telegram bot (setup steps: signals/dispatcher/README.md)
# Token from @BotFather. Never paste it into a chat, issue or commit.
TELEGRAM_BOT_TOKEN=
# Your personal chat id (a positive number). Get it with: python -m signals.dispatcher.bot chatid
TELEGRAM_CHAT_ID=
# Optional: ONE group the bot may also write to (a negative number). Leave empty for no group.
TELEGRAM_GROUP_ID=

# Freqtrade API server (local only, dry-run)
FREQTRADE_API_USERNAME=
FREQTRADE_API_PASSWORD=
FREQTRADE_JWT_SECRET=
